# Copy to .env and fill in. Never commit .env.

# --- Database -------------------------------------------------------------
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# Used when running the backend outside Docker (docker-compose sets its own).
DATABASE_URL=postgres://ledger:change-me-to-a-long-random-string@localhost:5432/ledger
DB_MAX_CONNECTIONS=10
RUN_MIGRATIONS=true

# --- HTTP & security ------------------------------------------------------
BIND_ADDR=127.0.0.1:8080
# The URL users open. State-changing requests from any other origin are refused.
PUBLIC_ORIGIN=http://localhost:8080
# Extra allowed origins, comma-separated (e.g. the Vite dev server).
ALLOWED_ORIGINS=http://localhost:5173
# Secure cookies work on http://localhost in modern browsers; keep true.
COOKIE_SECURE=true
# Only set true behind a reverse proxy you control that sets X-Forwarded-For.
TRUST_PROXY_HEADERS=false
SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=12
ALLOW_REGISTRATION=true

# --- Trading ----------------------------------------------------------------
STARTING_CASH=100000
TRADING_FEE_BPS=0

# --- Market data ------------------------------------------------------------
MARKETS_CONFIG=markets.toml
# Alpaca (US stocks). Leave empty to run crypto only.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# --- Logging ------------------------------------------------------------------
LOG_FORMAT=text
RUST_LOG=info,sqlx=warn
